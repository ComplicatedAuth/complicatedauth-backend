DATABASE_URL=postgres://complicatedauth:complicatedauth@localhost:5432/complicatedauth?sslmode=disable
CONSOLE_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SECRET_HASH_KEY=replace-with-at-least-32-random-bytes-base64url
LISTEN_ADDRESS=:8080
MIGRATIONS_DIR=migrations
# Empty means forwarding headers are ignored. Production ingress CIDRs may be comma-separated.
TRUSTED_PROXY_CIDRS=
BIOMETRIC_PROVIDER_URL=
BIOMETRIC_PROVIDER_TOKEN=
